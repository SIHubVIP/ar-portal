; Engine configuration file.
; Aolovo — «Песня» (новая редакция на Godot 4.7, см. docs/source)

config_version=5

[application]

config/name="Песня"
config/description="Aolovo «Песня» — изометрическая action-RPG: пришельцы прибыли не в тот город"
config/version="0.7.0"
run/main_scene="res://scenes/ui/title.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.07, 0.06, 0.1, 1)
boot_splash/image="res://assets/brand/logo.png"
boot_splash/fullsize=false
config/icon="res://assets/brand/icon.png"
config/quit_on_go_back=false

[autoload]

EventBus="*res://autoload/EventBus.gd"
GameData="*res://autoload/GameData.gd"
GameState="*res://autoload/GameState.gd"
QuestService="*res://autoload/QuestService.gd"
SaveService="*res://autoload/SaveService.gd"
WorldRouter="*res://autoload/WorldRouter.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Rubik.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
scaling_3d/mode=0
scaling_3d/scale=0.75
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.1, 1)
